{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Working name until the team picks the product name.
  "name": "store-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    // The webhook GET carries hub.verify_token in the query string.
    "redact_query_string": true
  },

  "vars": {
    "WHATSAPP_GRAPH_API_VERSION": "v26.0",
    // "1" opens the console without login, on an in-memory pretend engine. Only the simulator sets it.
    "DEV_CONSOLE": "",
    // With DEV_CONSOLE: the WhatsApp phone number ID of the simulator's store; the console acts as
    // its owner, so it shows the orders typed in `npm run chat`. Ignored without DEV_CONSOLE.
    "DEV_STORE_PHONE_NUMBER_ID": "",
    // "1" turns on the pretend engine with its state in D1 (migration 0016), for a deployed demo until
    // the real engine lands. The console still needs login. DEV_CONSOLE wins when both are set.
    "PRETEND_ENGINE": "",
    // The Worker's public origin (https://…, no trailing slash), for the privacy link in the first
    // message. Blank: the link is left out. Set it before customers write.
    "PUBLIC_BASE_URL": ""
  },

  // Values come from `wrangler secret put` when deployed, and from .dev.vars locally.
  // Tests blank all of them (vitest.config.ts).
  "secrets": {
    "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_TOKEN", "SENDER_HASH_SALT", "LINK_SIGNING_SECRET", "MODEL_API_KEY"]
  },

  // Voice notes: opus-decoder's libopus Wasm is extracted before bundling, because Workers can't
  // compile Wasm at runtime; its unused Web Worker variant is stubbed out (src/integrations/audio).
  "build": { "command": "node scripts/extract-opus-wasm.mjs" },
  "alias": { "@eshaz/web-worker": "./src/integrations/audio/no-web-worker.ts" },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "store-assistant",
      // database_id: set after `wrangler d1 create store-assistant` (Angel runs remote commands).
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "store-assistant-media"
    }
  ],

  // The queue is a doorbell: a message only says "this conversation has work". D1 holds the work.
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "store-assistant-jobs" }],
    "consumers": [
      {
        "queue": "store-assistant-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5
      }
    ]
  },

  // Every minute: re-ring stranded jobs, retry the outbox.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
