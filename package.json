{
  "name": "store-assistant",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:sim": "node scripts/dev-sim.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "simulate": "node scripts/simulate.mjs",
    "chat": "node scripts/chat.mjs",
    "admin:create-store": "node scripts/admin-create-store.mjs",
    "admin:invite": "node scripts/admin-invite.mjs",
    "qa": "node scripts/qa.mjs",
    "eval": "node scripts/eval.mjs"
  },
  "dependencies": {
    "hono": "^4.13.14",
    "opus-decoder": "0.7.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  }
}
